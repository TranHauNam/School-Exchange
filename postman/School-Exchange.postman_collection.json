{
  "info": {
    "_postman_id": "school-exchange-main",
    "name": "School Exchange - Luồng chính",
    "description": "Import cùng file Environment trong thư mục postman.\n\nChuẩn bị:\n1. `npm start`\n2. `node scripts/seed-test-users.js` (tạo admin + category Sách)\n3. Chọn environment **School Exchange - Local**\n4. Chạy folder theo thứ tự (hoặc Run collection)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Kiểm tra server",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Danh mục đang hoạt động",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/active"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Đăng ký - Người bán (seller)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Bán\",\n  \"email\": \"seller{{$timestamp}}@test.local\",\n  \"password\": \"123456\",\n  \"phone\": \"0901111111\",\n  \"userType\": \"student\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) {",
                "  pm.environment.set('sellerToken', j.data.token);",
                "  pm.environment.set('token', j.data.token);",
                "  if (j.data.session?.email) pm.environment.set('sellerEmail', j.data.session.email);",
                "}",
                "pm.test('Đăng ký thành công', () => pm.expect(j.success).to.be.true);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Đăng ký - Người mua (buyer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Trần Thị Mua\",\n  \"email\": \"buyer{{$timestamp}}@test.local\",\n  \"password\": \"123456\",\n  \"phone\": \"0902222222\",\n  \"userType\": \"student\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) {",
                "  pm.environment.set('buyerToken', j.data.token);",
                "  if (j.data.session?.email) pm.environment.set('buyerEmail', j.data.session.email);",
                "}",
                "pm.test('Đăng ký thành công', () => pm.expect(j.success).to.be.true);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Login - Member (email)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Đăng nhập thành viên bằng email + password.\nSau khi chạy, set token vào biến `token` nếu cần."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) {",
                "  pm.environment.set('token', j.data.token);",
                "  pm.environment.set('sellerToken', j.data.token);",
                "}",
                "pm.test('Login OK', () => pm.expect(j.success).to.be.true);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Login - Buyer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) pm.environment.set('buyerToken', j.data.token);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Admin login (username)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin-login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) pm.environment.set('adminToken', j.data.token);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Activity admin login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{activityUsername}}\",\n  \"password\": \"{{activityPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin-login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "if (j.success && j.data?.token) pm.environment.set('activityAdminToken', j.data.token);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Me (Bearer token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('token') });"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('token') });"],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "2. Bài đăng",
      "item": [
        {
          "name": "Tạo bài đăng bán",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sách Toán 10\",\n  \"content\": \"Sách còn mới 90%, không ghi chú.\",\n  \"type\": \"Sale\",\n  \"price\": 100000,\n  \"category\": \"{{categoryName}}\",\n  \"contact\": \"0901111111\",\n  \"imageName\": \"book-math10.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success && j.data?.id) pm.environment.set('postId', j.data.id);",
                  "pm.test('Tạo bài OK', () => pm.expect(j.success).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Feed (đã duyệt)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed?keyword=&category=All&type=All",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed"],
              "query": [
                { "key": "keyword", "value": "" },
                { "key": "category", "value": "All" },
                { "key": "type", "value": "All" }
              ]
            }
          }
        },
        {
          "name": "Chi tiết bài đăng",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Bài của tôi",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/posts/my"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Gửi yêu cầu mua/đổi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Mình muốn mua sách này.\",\n  \"contact\": \"0902222222\"\n}"
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}/requests"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set('token', pm.environment.get('buyerToken'));"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success && j.data?.id) pm.environment.set('requestId', j.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Admin duyệt bài",
      "item": [
        {
          "name": "Danh sách chờ duyệt",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/posts/pending"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('adminToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Duyệt bài",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/admin/posts/{{postId}}/approve"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('adminToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Từ chối bài",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Ảnh không rõ, vui lòng đăng lại.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/posts/{{postId}}/reject"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('adminToken'));"],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "4. Giao dịch (requests)",
      "item": [
        {
          "name": "Đã gửi (buyer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/requests/sent"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('buyerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Đã nhận (seller)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/requests/received"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Chấp nhận yêu cầu",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/accept"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Từ chối yêu cầu",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/reject"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Hoàn tất giao dịch (+ quỹ chung)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/complete"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Đã hoàn tất",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/requests/completed"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('sellerToken'));"],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "5. Chiến dịch & Quỹ",
      "item": [
        {
          "name": "Tạo chiến dịch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quyên góp sách vở 2026\",\n  \"type\": \"Fundraising\",\n  \"start\": \"2026-06-01\",\n  \"end\": \"2026-12-31\",\n  \"description\": \"Thu gom sách cho học sinh khó khăn\",\n  \"targetFund\": 5000000,\n  \"is_free\": false,\n  \"cover\": \"STUDY\"\n}"
            },
            "url": "{{baseUrl}}/api/campaigns"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set('token', pm.environment.get('activityAdminToken') || pm.environment.get('sellerToken'));"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.success && j.data?.id) pm.environment.set('campaignId', j.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Danh sách chiến dịch",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/campaigns"
          }
        },
        {
          "name": "Xem quỹ chung (activity admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/activity-admin/fund"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('activityAdminToken'));"],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Chiến dịch của tôi",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/activity-admin/campaigns"
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": ["pm.environment.set('token', pm.environment.get('activityAdminToken'));"],
              "type": "text/javascript"
            }
          }]
        }
      ]
    }
  ]
}
